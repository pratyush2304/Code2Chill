# Required in production: long random string (python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me
# Local admin account, created/updated on startup and by `python -m app.seed`.
# Replace the password before exposing the app to a network.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=local-admin-password
# Legacy email-based admin setting also works when ADMIN_USERNAME is unset.
# ADMIN_EMAIL=admin@example.com
# Demo member (username: demo); replace this password for shared environments.
DEMO_USER_PASSWORD=Code2ChillDemo123!
# SQLite by default; use e.g. postgresql+psycopg://user:pass@host/db in production
DATABASE_URL=sqlite:///./c2c.db
# Set to 1 when served over HTTPS so the session cookie is Secure
COOKIE_SECURE=0
